# LocalBuddy Backend Environment Variables (MVP)
# Copy this to .env and fill in real values. NEVER commit .env.

# ============================================
# SERVER
# ============================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ============================================
# FIREBASE ADMIN SDK (required)
# Firebase Console > Project Settings > Service Accounts
# ============================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================
# JWT (internal tokens)
# ============================================
JWT_SECRET=change-me-in-production
JWT_EXPIRY=7d

# ============================================
# PAYU PAYMENT GATEWAY (wallet top-up / escrow)
# Test: https://test.payu.in | Prod: https://secure.payu.in
# ============================================
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_MERCHANT_SALT=your_payu_merchan_salt
PAYU_BASE_URL=https://test.payu.in

# ============================================
# AUTHKEY.IO (OTP SMS — the only OTP channel)
# ============================================
AUTHKEY_API_KEY=your_authkey_api_key
AUTHKEY_SENDER_ID=LBUDDY
AUTHKEY_ROUTE=4

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_MAX=3

# ============================================
# SECURITY / APP
# ============================================
CORS_ORIGIN=*
APP_URL=http://localhost:3000
