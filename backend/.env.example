# LocalBuddy Backend Environment Variables (MVP)
# Copy this to .env and fill in real values. NEVER commit .env.

# ============================================
# SERVER
# ============================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ============================================
# FIREBASE ADMIN SDK (required)
# Firebase Console > Project Settings > Service Accounts
# ============================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================
# JWT (internal tokens)
# ============================================
JWT_SECRET=change-me-in-production
JWT_EXPIRY=7d

# ============================================
# PAYU PAYMENT GATEWAY (wallet top-up / escrow)
# Prod (default): https://secure.payu.in | Test: https://test.payu.in
# IMPORTANT: the base URL env must match the environment your
# merchant key/salt belong to, or PayU shows "Pardon, Some Problem
# Occurred" instead of checkout. This app's keys are LIVE → secure.payu.in.
# ============================================
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_MERCHANT_SALT=your_payu_merchan_salt
PAYU_BASE_URL=https://secure.payu.in
# Optional explicit selector used when PAYU_BASE_URL is unset:
#   PAYU_ENV=test  → test.payu.in    anything else → secure.payu.in
# PAYU_ENV=prod

# Admin key for internal ops like KYC review (set to a long random string)
ADMIN_KEY=change_me_to_a_long_random_string

# ============================================
# MOJOAUTH (Email OTP)
# Dashboard: https://dashboard.mojoauth.com
# ============================================
MOJOAUTH_API_KEY=your_mojoauth_api_key
MOJOAUTH_API_SECRET=your_mojoauth_api_secret
MOJOAUTH_BASE_URL=https://api.mojoauth.com

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_MAX=3

# ============================================
# SECURITY / APP
# ============================================
CORS_ORIGIN=*
APP_URL=http://localhost:3000
