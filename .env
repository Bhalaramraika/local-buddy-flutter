# ============================================
# RAZORPAY CONFIGURATION
# ============================================
# Get from Razorpay Dashboard > Settings > API Keys
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=your-secret-key (backend only)

# ============================================
# SOCKET.IO SERVER
# ============================================
EXPO_PUBLIC_SOCKET_URL=https://socket.localbuddy.app
EXPO_PUBLIC_SOCKET_PATH=/socket.io

# ============================================
# PUSH NOTIFICATIONS (FCM)
# ============================================
# FCM Server Key from Firebase Console > Cloud Messaging
# FCM_SERVER_KEY=your-fcm-server-key (backend only)
EXPO_PUBLIC_FCM_SENDER_ID=123456789

# ============================================
# SOCIAL LOGIN PROVIDERS
# ============================================
# Google OAuth
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_SECRET=your-google-client-secret (backend only)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Apple Sign In
EXPO_PUBLIC_APPLE_CLIENT_ID=com.localbuddy.app
EXPO_PUBLIC_APPLE_TEAM_ID=your-apple-team-id
EXPO_PUBLIC_APPLE_KEY_ID=your-key-id
EXPO_PUBLIC_APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n" (backend only)

# Facebook Login
EXPO_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
EXPO_PUBLIC_FACEBOOK_APP_SECRET=your-facebook-app-secret (backend only)

# ============================================
# ANALYTICS & MONITORING
# ============================================
# Sentry
EXPO_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token (for sourcemap upload)
SENTRY_ORG=your-org
SENTRY_PROJECT=localbuddy

# Amplitude
EXPO_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-api-key

# Mixpanel
EXPO_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token

# ============================================
# FEATURE FLAGS
# ============================================
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=true
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_LOCATION_TRACKING=true
EXPO_PUBLIC_ENABLE_CHAT=true
EXPO_PUBLIC_ENABLE_WALLET=true
EXPO_PUBLIC_ENABLE_KYC=true
EXPO_PUBLIC_ENABLE_REFERRAL=true
EXPO_PUBLIC_ENABLE_DARK_MODE=true
EXPO_PUBLIC_ENABLE_BIOMETRIC=true

# ============================================
# DEVELOPMENT / DEBUG
# ============================================
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_LOG_LEVEL=info
EXPO_PUBLIC_MOCK_API=false
EXPO_PUBLIC_MOCK_LOCATION=false
EXPO_PUBLIC_SHOW_PERFORMANCE_MONITOR=false

# ============================================
# STORAGE KEYS (for reference)
# ============================================
# These are used internally by the storage service
# STORAGE_AUTH_TOKEN_KEY=@localbuddy/auth_token
# STORAGE_REFRESH_TOKEN_KEY=@localbuddy/refresh_token
# STORAGE_USER_DATA_KEY=@localbuddy/user_data
# STORAGE_PREFERENCES_KEY=@localbuddy/preferences
# STORAGE_SETTINGS_KEY=@localbuddy/settings
# STORAGE_THEME_KEY=@localbuddy/theme
# STORAGE_FCM_TOKEN_KEY=@localbuddy/fcm_token
# STORAGE_LOCATION_KEY=@localbuddy/location
# STORAGE_ONBOARDING_COMPLETE_KEY=@localbuddy/onboarding_complete

# ============================================
# DEEP LINKING
# ============================================
EXPO_PUBLIC_DEEP_LINK_SCHEME=localbuddy
EXPO_PUBLIC_UNIVERSAL_LINK_DOMAIN=localbuddy.app

# ============================================
# APP STORE / PLAY STORE
# ============================================
EXPO_PUBLIC_IOS_APP_STORE_ID=1234567890
EXPO_PUBLIC_ANDROID_PLAY_STORE_ID=com.localbuddy.app

# ============================================
# SUPPORT / CONTACT
# ============================================
EXPO_PUBLIC_SUPPORT_EMAIL=support@localbuddy.app
EXPO_PUBLIC_SUPPORT_PHONE=+91-XXXXXXXXXX
EXPO_PUBLIC_WEBSITE_URL=https://localbuddy.app